{
  "enabledPlugins": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": true
  },
  "plansDirectory": "./plans",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "WebSearch",
      "Bash(docker compose run*)",
      "Bash(docker compose:*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(git worktree list*)",
      "Bash(python3 .claude/hooks/stop-sensors.py*)",
      "Bash(pnpm run type-check*)",
      "Bash(pnpm run lint*)",
      "Bash(pnpm run test*)",
      "Bash(pnpm run build*)",
      "Bash(gofmt*)",
      "Bash(go vet*)",
      "Bash(go build*)",
      "Bash(go test*)",
      "Bash(go run*)",
      "Bash(go generate*)",
      "Bash(go mod tidy*)",
      "Bash(go mod download*)",
      "Bash(sqlc generate*)",
      "Bash(.agents/skills/backend-go-change-validation/scripts/go-checks.sh*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git switch*)",
      "Bash(git checkout -b*)",
      "Bash(git worktree add*)",
      "Bash(git worktree remove*)",
      "Bash(git push origin feat/*)",
      "Bash(git push -u origin feat/*)",
      "Bash(gh pr create --draft*)",
      "Bash(gh pr ready*)",
      "Bash(gh issue create*)",
      "Bash(gh issue edit*)",
      "Bash(pnpm install*)",
      "Bash(mkdir*)",
      "Bash(ln -s*)",
      "Bash(chmod +x*)",
      "Bash(docker*)",
      "Bash(curl*)",
      "Bash(git push*)",
      "Bash(gh pr create*)"
    ],
    "ask": [
      "Bash(gh pr edit*)",
      "Bash(gh pr close*)",
      "Bash(gh pr merge*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(backend/.env)",
      "Read(backend/.env.*)",
      "Read(backend-go/.env)",
      "Read(backend-go/.env.*)",
      "Read(frontend/.env)",
      "Read(frontend/.env.*)",
      "Read(design/.env)",
      "Read(design/.env.*)",
      "Read(secrets/**)",
      "Read(**/secrets/**)",
      "Read(backend/.kamal/secrets)",
      "Read(backend/.kamal/secrets/**)",
      "Read(backend/config/master.key)",
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git rebase*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/stop-sensors.py"
          }
        ]
      }
    ]
  }
}
