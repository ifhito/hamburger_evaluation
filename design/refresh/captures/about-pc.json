":702.1328125,"y":236.59375},{"ctl":0,"h":160.5,"kind":"text","lines":[{"h":70.5,"text":"世の中に、もっと","w":492,"x":394,"y":337.09375},{"h":70.5,"text":"ハンバーガーを！！！","w":609.6015625,"x":335.1953125,"y":427.09375}],"name":"h1","style":{"align":"center","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":1.5,"lineHeight":90,"size":60,"underline":false,"weight":"700"},"tag":"h1","text":"世の中に、もっと ハンバーガーを！！！","w":609.6015625,"x":335.1953125,"y":337.09375},{"ctl":0,"h":51,"kind":"text","lines":[{"h":19,"text":"お気に入りの一口を探して、","w":206.40625,"x":536.796875,"y":542.09375},{"h":19,"text":"ハンバーガーの楽しみを広げよう。","w":252.484375,"x":513.7578125,"y":574.09375}],"name":"lead","style":{"align":"center","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"お気に入りの一口を探して、 ハンバーガーの楽しみを広げよう。","w":252.484375,"x":513.7578125,"y":542.09375},{"ctl":0,"h":35.5,"kind":"text","lines":[{"h":35.5,"text":"Hello World！","w":190.9765625,"x":288,"y":807.1875}],"name":"h2","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":48,"size":30,"underline":false,"weight":"700"},"tag":"h2","text":"Hello World！","w":190.9765625,"x":288,"y":807.1875},{"ctl":0,"h":19,"kind":"text","lines":[{"h":19,"text":"ハンバーガーが好きな、しがないエンジニアです。","w":363.3671875,"x":288,"y":883.6875}],"name":"p","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"ハンバーガーが好きな、しがないエンジニアです。","w":363.3671875,"x":288,"y":883.6875},{"ctl":0,"h":19,"kind":"text","lines":[{"h":19,"text":"突然ですが、みなさんはどれくらいハンバーガーを食べていますか？","w":492.9609375,"x":288,"y":943.6875}],"name":"p","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"突然ですが、みなさんはどれくらいハンバーガーを食べていますか？","w":492.9609375,"x":288,"y":943.6875},{"ctl":0,"h":51,"kind":"text","lines":[{"h":19,"text":"街を歩けば、あちこちで見かけるハンバーガーのチェーン店。少し調べてみると、個人で営むハン","w":700,"x":288,"y":1003.6875},{"h":19,"text":"バーガー屋さんも、実は驚くほどたくさんあります。","w":381.125,"x":288,"y":1035.6875}],"name":"p","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"街を歩けば、あちこちで見かけるハンバーガーのチェーン店。少し調べてみると、個人で営むハンバーガー屋さんも、実は驚くほどたくさんあります。","w":700,"x":288,"y":1003.6875},{"ctl":0,"h":51,"kind":"text","lines":[{"h":19,"text":"身近な食べ物でありながら、お店ごとの個性も楽しめる。それがハンバーガーの魅力だと思ってい","w":701.4453125,"x":288,"y":1095.6875},{"h":19,"text":"ます。","w":46.40625,"x":288,"y":1127.6875}],"name":"p","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"身近な食べ物でありながら、お店ごとの個性も楽しめる。それがハンバーガーの魅力だと思っています。","w":701.4453125,"x":288,"y":1095.6875},{"ctl":0,"h":35.5,"kind":"text","lines":[{"h":35.5,"text":"ハンバーガーだって、もっと語りたい。","w":534,"x":288,"y":1271.1875}],"name":"h2","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":48,"size":30,"underline":false,"weight":"700"},"tag":"h2","text":"ハンバーガーだって、もっと語りたい。","w":534,"x":288,"y":1271.1875},{"ctl":0,"h":19,"kind":"text","lines":[{"h":19,"text":"でも、ハンバーガー好きとしては、ちょっと物足りないことがあります。","w":523.3671875,"x":288,"y":1347.6875}],"name":"p","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"でも、ハンバーガー好きとしては、ちょっと物足りないことがあります。","w":523.3671875,"x":288,"y":1347.6875},{"ctl":0,"h":51,"kind":"text","lines":[{"h":19,"text":"たとえばラーメンなら、お気に入りのお店を語り合ったり、気になる一杯のために遠くまで出かけ","w":702.7265625,"x":288,"y":1407.6875},{"h":19,"text":"たり。そんな楽しみ方が、ハンバーガーではまだ少ないように感じるんです。","w":554.7265625,"x":288,"y":1439.6875}],"name":"p","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"たとえばラーメンなら、お気に入りのお店を語り合ったり、気になる一杯のために遠くまで出かけたり。そんな楽しみ方が、ハンバーガーではまだ少ないように感じるんです。","w":702.7265625,"x":288,"y":1407.6875},{"ctl":0,"h":145,"kind":"text","lines":[{"h":33,"text":"ハンバーガーだって、もっと語りたい。もっと食べ歩き","w":694.40625,"x":288,"y":1524.6875},{"h":33,"text":"たい。","w":84,"x":288,"y":1580.6875},{"h":33,"text":"そして、まだ知らないおいしいお店に出会いたい！","w":641.484375,"x":288,"y":1636.6875}],"name":"emphasis","style":{"align":"start","color":"#916c0a","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":56,"size":28,"underline":false,"weight":"700"},"tag":"p","text":"ハンバーガーだって、もっと語りたい。もっと食べ歩きたい。 そして、まだ知らないおいしいお店に出会いたい！","w":694.40625,"x":288,"y":1524.6875},{"ctl":0,"h":51,"kind":"text","lines":[{"h":19,"text":"「世の中に、もっとハンバーガーを！！！」","w":317.921875,"x":288,"y":1715.6875},{"h":19,"text":"そんな気持ちで、このサイトを作りました。","w":318.7265625,"x":288,"y":1747.6875}],"name":"p","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"「世の中に、もっとハンバーガーを！！！」 そんな気持ちで、このサイトを作りました。","w":318.7265625,"x":288,"y":1715.6875},{"ctl":0,"h":35.5,"kind":"text","lines":[{"h":35.5,"text":"いつもの選択肢に、ハンバーガーを。","w":507.3046875,"x":288,"y":1891.1875}],"name":"h2","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":48,"size":30,"underline":false,"weight":"700"},"tag":"h2","text":"いつもの選択肢に、ハンバーガーを。","w":507.3046875,"x":288,"y":1891.1875},{"ctl":0,"h":51,"kind":"text","lines":[{"h":19,"text":"目指しているのは、「今日のお昼、何にする？」「夕飯、どこに行こう？」という会話の中で、近所","w":700.9609375,"x":288,"y":1967.6875},{"h":19,"text":"のハンバーガー屋さんが自然と候補に挙がること。","w":365.921875,"x":288,"y":1999.6875}],"name":"p","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"目指しているのは、「今日のお昼、何にする？」「夕飯、どこに行こう？」という会話の中で、近所のハンバーガー屋さんが自然と候補に挙がること。","w":700.9609375,"x":288,"y":1967.6875},{"ctl":0,"h":83,"kind":"text","lines":[{"h":19,"text":"いつものチェーン店に加えて、店主のこだわりが詰まった一軒も、日々の選択肢になってほしい。","w":700.1640625,"x":288,"y":2059.6875},{"h":19,"text":"そして、お気に入りのお店や一口との出会いを通じて、ハンバーガーを楽しむ仲間が増えてほしい","w":698.40625,"x":288,"y":2091.6875},{"h":19,"text":"と思っています。","w":125.921875,"x":288,"y":2123.6875}],"name":"p","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"いつものチェーン店に加えて、店主のこだわりが詰まった一軒も、日々の選択肢になってほしい。そして、お気に入りのお店や一口との出会いを通じて、ハンバーガーを楽しむ仲間が増えてほしいと思っています。","w":700.1640625,"x":288,"y":2059.6875},{"ctl":0,"h":35.5,"kind":"text","lines":[{"h":35.5,"text":"「おいしかった！」を、積み重ねて。","w":508.203125,"x":288,"y":2267.1875}],"name":"h2","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":48,"size":30,"underline":false,"weight":"700"},"tag":"h2","text":"「おいしかった！」を、積み重ねて。","w":508.203125,"x":288,"y":2267.1875},{"ctl":0,"h":51,"kind":"text","lines":[{"h":19,"text":"サイトの名前は、Burger Stack。","w":237.4453125,"x":288,"y":2343.6875},{"h":19,"text":"ハンバーガーが積み上がっていくイメージから名付けました。","w":444,"x":288,"y":2375.6875}],"name":"p","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"サイトの名前は、Burger Stack。 ハンバーガーが積み上がっていくイメージから名付けました。","w":444,"x":288,"y":2343.6875},{"ctl":0,"h":51,"kind":"text","lines":[{"h":19,"text":"ここに集まる「おいしかった！」が一つずつ積み重なって、いつか月まで届いたらいいな。そんな","w":702.8828125,"x":288,"y":2435.6875},{"h":19,"text":"ことを思ったり、思わなかったりしています。","w":332.9609375,"x":288,"y":2467.6875}],"name":"p","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"ここに集まる「おいしかった！」が一つずつ積み重なって、いつか月まで届いたらい