"ハンバーガーを！！！","w":287,"x":44,"y":398.28125}],"name":"h1","style":{"align":"center","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0.7,"lineHeight":42,"size":28,"underline":false,"weight":"700"},"tag":"h1","text":"世の中に、もっと ハンバーガーを！！！","w":287,"x":44,"y":356.28125},{"ctl":0,"h":55,"kind":"text","lines":[{"h":23,"text":"お気に入りの一口を探して、","w":206.7265625,"x":84.1328125,"y":472.28125},{"h":23,"text":"ハンバーガーの楽しみを広げよう。","w":255.046875,"x":59.9765625,"y":504.28125}],"name":"lead","style":{"align":"center","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"お気に入りの一口を探して、 ハンバーガーの楽しみを広げよう。","w":255.046875,"x":59.9765625,"y":472.28125},{"ctl":0,"h":32,"kind":"text","lines":[{"h":32,"text":"Hello World！","w":148.6484375,"x":24,"y":645.28125}],"name":"h2","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":35.2,"size":22,"underline":false,"weight":"700"},"tag":"h2","text":"Hello World！","w":148.6484375,"x":24,"y":645.28125},{"ctl":0,"h":55,"kind":"text","lines":[{"h":23,"text":"ハンバーガーが好きな、しがないエンジニア","w":320,"x":24,"y":711.4765625},{"h":23,"text":"です。","w":46.40625,"x":24,"y":743.4765625}],"name":"p","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"ハンバーガーが好きな、しがないエンジニアです。","w":320,"x":24,"y":711.4765625},{"ctl":0,"h":55,"kind":"text","lines":[{"h":23,"text":"突然ですが、みなさんはどれくらいハンバー","w":319.6875,"x":24,"y":803.4765625},{"h":23,"text":"ガーを食べていますか？","w":175.3671875,"x":24,"y":835.4765625}],"name":"p","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"突然ですが、みなさんはどれくらいハンバーガーを食べていますか？","w":319.6875,"x":24,"y":803.4765625},{"ctl":0,"h":119,"kind":"text","lines":[{"h":23,"text":"街を歩けば、あちこちで見かけるハンバーガ","w":320,"x":24,"y":895.4765625},{"h":23,"text":"ーのチェーン店。少し調べてみると、個人で","w":317.921875,"x":24,"y":927.4765625},{"h":23,"text":"営むハンバーガー屋さんも、実は驚くほどた","w":319.5234375,"x":24,"y":959.4765625},{"h":23,"text":"くさんあります。","w":126.40625,"x":24,"y":991.4765625}],"name":"p","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"街を歩けば、あちこちで見かけるハンバーガーのチェーン店。少し調べてみると、個人で営むハンバーガー屋さんも、実は驚くほどたくさんあります。","w":320,"x":24,"y":895.4765625},{"ctl":0,"h":87,"kind":"text","lines":[{"h":23,"text":"身近な食べ物でありながら、お店ごとの個性","w":319.6875,"x":24,"y":1051.4765625},{"h":23,"text":"も楽しめる。それがハンバーガーの魅力だと","w":320,"x":24,"y":1083.4765625},{"h":23,"text":"思っています。","w":109.6015625,"x":24,"y":1115.4765625}],"name":"p","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"身近な食べ物でありながら、お店ごとの個性も楽しめる。それがハンバーガーの魅力だと思っています。","w":320,"x":24,"y":1051.4765625},{"ctl":0,"h":67.1953125,"kind":"text","lines":[{"h":32,"text":"ハンバーガーだって、もっと語","w":305.8046875,"x":24,"y":1208.4765625},{"h":32,"text":"りたい。","w":88,"x":24,"y":1243.671875}],"name":"h2","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":35.2,"size":22,"underline":false,"weight":"700"},"tag":"h2","text":"ハンバーガーだって、もっと語りたい。","w":305.8046875,"x":24,"y":1208.4765625},{"ctl":0,"h":55,"kind":"text","lines":[{"h":23,"text":"でも、ハンバーガー好きとしては、ちょっと","w":318.7265625,"x":24,"y":1309.8671875},{"h":23,"text":"物足りないことがあります。","w":206.40625,"x":24,"y":1341.8671875}],"name":"p","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"でも、ハンバーガー好きとしては、ちょっと物足りないことがあります。","w":318.7265625,"x":24,"y":1309.8671875},{"ctl":0,"h":119,"kind":"text","lines":[{"h":23,"text":"たとえばラーメンなら、お気に入りのお店を","w":319.3671875,"x":24,"y":1401.8671875},{"h":23,"text":"語り合ったり、気になる一杯のために遠くま","w":319.3671875,"x":24,"y":1433.8671875},{"h":23,"text":"で出かけたり。そんな楽しみ方が、ハンバー","w":319.3671875,"x":24,"y":1465.8671875},{"h":23,"text":"ガーではまだ少ないように感じるんです。","w":300.3203125,"x":24,"y":1497.8671875}],"name":"p","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"たとえばラーメンなら、お気に入りのお店を語り合ったり、気になる一杯のために遠くまで出かけたり。そんな楽しみ方が、ハンバーガーではまだ少ないように感じるんです。","w":319.3671875,"x":24,"y":1401.8671875},{"ctl":0,"h":149,"kind":"text","lines":[{"h":29,"text":"ハンバーガーだって、もっと語りた","w":318,"x":24,"y":1578.8671875},{"h":29,"text":"い。もっと食べ歩きたい。","w":240,"x":24,"y":1618.8671875},{"h":29,"text":"そして、まだ知らないおいしいお店","w":318.40625,"x":24,"y":1658.8671875},{"h":29,"text":"に出会いたい！","w":140,"x":24,"y":1698.8671875}],"name":"emphasis","style":{"align":"start","color":"#916c0a","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":40,"size":20,"underline":false,"weight":"700"},"tag":"p","text":"ハンバーガーだって、もっと語りたい。もっと食べ歩きたい。 そして、まだ知らないおいしいお店に出会いたい！","w":318.40625,"x":24,"y":1578.8671875},{"ctl":0,"h":55,"kind":"text","lines":[{"h":23,"text":"「世の中に、もっとハンバーガーを！！！」","w":319.5234375,"x":24,"y":1765.8671875},{"h":23,"text":"そんな気持ちで、このサイトを作りました。","w":319.3671875,"x":24,"y":1797.8671875}],"name":"p","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"「世の中に、もっとハンバーガーを！！！」 そんな気持ちで、このサイトを作りました。","w":319.5234375,"x":24,"y":1765.8671875},{"ctl":0,"h":67.1953125,"kind":"text","lines":[{"h":32,"text":"いつもの選択肢に、ハンバーガ","w":307.34375,"x":24,"y":1890.8671875},{"h":32,"text":"ーを。","w":66,"x":24,"y":1926.0625}],"name":"h2","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":35.2,"size":22,"underline":false,"weight":"700"},"tag":"h2","te