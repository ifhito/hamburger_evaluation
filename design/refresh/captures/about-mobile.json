[{"h":33,"text":"世の中に、もっと","w":229.6015625,"x":72.6953125,"y":360.28125},{"h":33,"text":"ハンバーガーを！！！","w":284.484375,"x":45.2578125,"y":402.28125}],"name":"h1","style":{"align":"center","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0.7,"lineHeight":42,"size":28,"underline":false,"weight":"700"},"tag":"h1","text":"世の中に、もっと ハンバーガーを！！！","w":284.484375,"x":45.2578125,"y":360.28125},{"ctl":0,"h":51,"kind":"text","lines":[{"h":19,"text":"お気に入りの一口を探して、","w":206.40625,"x":84.296875,"y":474.28125},{"h":19,"text":"ハンバーガーの楽しみを広げよう。","w":252.484375,"x":61.2578125,"y":506.28125}],"name":"lead","style":{"align":"center","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"お気に入りの一口を探して、 ハンバーガーの楽しみを広げよう。","w":252.484375,"x":61.2578125,"y":474.28125},{"ctl":0,"h":26,"kind":"text","lines":[{"h":26,"text":"Hello World！","w":140.0703125,"x":24,"y":648.28125}],"name":"h2","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":35.2,"size":22,"underline":false,"weight":"700"},"tag":"h2","text":"Hello World！","w":140.0703125,"x":24,"y":648.28125},{"ctl":0,"h":51,"kind":"text","lines":[{"h":19,"text":"ハンバーガーが好きな、しがないエンジニア","w":316.9609375,"x":24,"y":713.4765625},{"h":19,"text":"です。","w":46.40625,"x":24,"y":745.4765625}],"name":"p","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"ハンバーガーが好きな、しがないエンジニアです。","w":316.9609375,"x":24,"y":713.4765625},{"ctl":0,"h":51,"kind":"text","lines":[{"h":19,"text":"突然ですが、みなさんはどれくらいハンバー","w":317.921875,"x":24,"y":805.4765625},{"h":19,"text":"ガーを食べていますか？","w":175.5234375,"x":24,"y":837.4765625}],"name":"p","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"突然ですが、みなさんはどれくらいハンバーガーを食べていますか？","w":317.921875,"x":24,"y":805.4765625},{"ctl":0,"h":115,"kind":"text","lines":[{"h":19,"text":"街を歩けば、あちこちで見かけるハンバーガ","w":317.4453125,"x":24,"y":897.4765625},{"h":19,"text":"ーのチェーン店。少し調べてみると、個人で","w":318.5625,"x":24,"y":929.4765625},{"h":19,"text":"営むハンバーガー屋さんも、実は驚くほどた","w":317.921875,"x":24,"y":961.4765625},{"h":19,"text":"くさんあります。","w":126.40625,"x":24,"y":993.4765625}],"name":"p","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"街を歩けば、あちこちで見かけるハンバーガーのチェーン店。少し調べてみると、個人で営むハンバーガー屋さんも、実は驚くほどたくさんあります。","w":318.5625,"x":24,"y":897.4765625},{"ctl":0,"h":83,"kind":"text","lines":[{"h":19,"text":"身近な食べ物でありながら、お店ごとの個性","w":320,"x":24,"y":1053.4765625},{"h":19,"text":"も楽しめる。それがハンバーガーの魅力だと","w":317.921875,"x":24,"y":1085.4765625},{"h":19,"text":"思っています。","w":109.921875,"x":24,"y":1117.4765625}],"name":"p","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"身近な食べ物でありながら、お店ごとの個性も楽しめる。それがハンバーガーの魅力だと思っています。","w":320,"x":24,"y":1053.4765625},{"ctl":0,"h":61.1953125,"kind":"text","lines":[{"h":26,"text":"ハンバーガーだって、もっと語り","w":325.6015625,"x":24,"y":1211.4765625},{"h":26,"text":"たい。","w":66,"x":24,"y":1246.671875}],"name":"h2","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":35.2,"size":22,"underline":false,"weight":"700"},"tag":"h2","text":"ハンバーガーだって、もっと語りたい。","w":325.6015625,"x":24,"y":1211.4765625},{"ctl":0,"h":51,"kind":"text","lines":[{"h":19,"text":"でも、ハンバーガー好きとしては、ちょっと","w":316.9609375,"x":24,"y":1311.8671875},{"h":19,"text":"物足りないことがあります。","w":206.40625,"x":24,"y":1343.8671875}],"name":"p","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"でも、ハンバーガー好きとしては、ちょっと物足りないことがあります。","w":316.9609375,"x":24,"y":1311.8671875},{"ctl":0,"h":115,"kind":"text","lines":[{"h":19,"text":"たとえばラーメンなら、お気に入りのお店を","w":318.7265625,"x":24,"y":1403.8671875},{"h":19,"text":"語り合ったり、気になる一杯のために遠くま","w":320,"x":24,"y":1435.8671875},{"h":19,"text":"で出かけたり。そんな楽しみ方が、ハンバー","w":318.40625,"x":24,"y":1467.8671875},{"h":19,"text":"ガーではまだ少ないように感じるんです。","w":300.8046875,"x":24,"y":1499.8671875}],"name":"p","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"たとえばラーメンなら、お気に入りのお店を語り合ったり、気になる一杯のために遠くまで出かけたり。そんな楽しみ方が、ハンバーガーではまだ少ないように感じるんです。","w":320,"x":24,"y":1403.8671875},{"ctl":0,"h":143.5,"kind":"text","lines":[{"h":23.5,"text":"ハンバーガーだって、もっと語りた","w":316,"x":24,"y":1581.3671875},{"h":23.5,"text":"い。もっと食べ歩きたい。","w":240,"x":24,"y":1621.3671875},{"h":23.5,"text":"そして、まだ知らないおいしいお店","w":318.203125,"x":24,"y":1661.3671875},{"h":23.5,"text":"に出会いたい！","w":140,"x":24,"y":1701.3671875}],"name":"emphasis","style":{"align":"start","color":"#916c0a","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":40,"size":20,"underline":false,"weight":"700"},"tag":"p","text":"ハンバーガーだって、もっと語りたい。もっと食べ歩きたい。 そして、まだ知らないおいしいお店に出会いたい！","w":318.203125,"x":24,"y":1581.3671875},{"ctl":0,"h":51,"kind":"text","lines":[{"h":19,"text":"「世の中に、もっとハンバーガーを！！！」","w":317.921875,"x":24,"y":1767.8671875},{"h":19,"text":"そんな気持ちで、このサイトを作りました。","w":318.7265625,"x":24,"y":1799.8671875}],"name":"p","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"「世の中に、もっとハンバーガーを！！！」 そんな気持ちで、このサイトを作りました。","w":318.7265625,"x":24,"y":1767.8671875},{"ctl":0,"h":61.1953125,"kind":"text","lines":[{"h":26,"text":"いつもの選択肢に、ハンバーガ","w":306.0234375,"x":24,"y":1893.8671875},{"h":26,"text":"ーを。","w":66,"x":24,"y":1929.0625}],"name":"h2","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":35.2,"size":22,"underline":false,"weight":"700"},"tag":"h2","text":"いつもの選択肢に、ハンバーガーを。","w":306.0234375,"x":24,"y":1893.8671875},{"ctl":0,"h":115,"kind":"text","lines":[{"h":19,"text":"目指しているのは、「今日のお昼、何にす","w":295.046875,"x":24,"y":1994.2578125},{"h":19,"text":"る？」「夕飯、どこに行こう？」という会話の","w":326.7265625,"x":24,"y":2026.2578125},{"h":19,"text":"中で、近所のハンバーガー屋さんが自然と候","w":317.125,"x":24,"y":2058.2578125},{"h":19,"text":"補に挙がること。","w":128,"x":24,"y":2090.2578125}],"name":"p","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"目指しているのは、「今日のお昼、何にする？」「夕飯、どこに行こう？」という会話の中で、近所のハンバーガー屋さんが自然と候補に挙がること。","w":326.7265625,"x":24,"y":1994.2578125},{"ctl":0,"h":147,"kind":"text","lines":[{"h":19,"text":"いつものチェーン店に加えて、店主のこだわ","w":316.640625,"x":24,"y":2150.2578125},{"h":19,"text":"りが詰まった一軒も、日々の選択肢になって","w":319.5234375,"x":24,"y":2182.2578125},{"h":19,"text":"ほしい。そして、お気に入りのお店や一口と","w":318.40625,"x":24,"y":2214.2578125},{"h":19,"text":"の出会いを通じて、ハンバーガーを楽しむ仲","w":317.28125,"x":24,"y":2246.2578125},{"h":19,"text":"間が増えてほしいと思っています。","w":252.640625,"x":24,"y":2278.2578125}],"name":"p","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":32,"size":16,"underline":false,"weight":"400"},"tag":"p","text":"いつものチェーン店に加えて、店主のこだわりが詰まった一軒も、日々の選択肢になってほしい。そして、お気に入りのお店や一口との出会いを通じて、ハンバーガーを楽しむ仲間が増えてほしいと思っています。","w":319.5234375,"x":24,"y":2150.2578125},{"ctl":0,"h":61.1953125,"kind":"text","lines":[{"h":26,"text":"「おいしかった！」を、積み重","w":308,"x":24,"y":2372.2578125},{"h":26,"text":"ねて。","w":64.6875,"x":24,"y":2407.453125}],"name":"h2","style":{"align":"start","color":"#111827","family":"Noto Sans JP Variable","letterSpacing":0,"lineHeight":35.2,"size":22,"underline":false,"weight":"700"},"tag":"h2","text":"「おいしかった！」を、積み重ねて。","w":308,"x":24,"y":2372.2578125},{"ctl":0,"h