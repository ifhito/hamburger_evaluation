# Phase 1(DB 比較)用の接続文字列。`cp .env.bench.example .env.bench` して使う。
# .env.bench は .gitignore の `.env.*` で無視される。コミットされない。
#
# 使い方:
#   source backend-go/.env.bench
#   ./scripts/bench/db-verify.sh neon     "$NEON_URL"
#   ./scripts/bench/db-verify.sh supabase "$SUPABASE_URL"
#   ./scripts/bench/db-verify.sh render   "$RENDER_URL"
#   ./scripts/bench/db-verify.sh xata     "$XATA_URL"
#
# Neon と Supabase は「プーラー経由(Pooled / Connection pooling)」の URL を選ぶこと。
# 直結 URL は接続数がすぐ足りなくなる。
# Render は「External Database URL」を選ぶこと(ローカルから繋ぐため)。

NEON_URL="postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require"
SUPABASE_URL="postgres://USER:PASSWORD@HOST:6543/postgres?sslmode=require"
RENDER_URL="postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require"
XATA_URL="postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require"
