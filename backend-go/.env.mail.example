# Phase 3(メール送信の比較)用。`cp .env.mail.example .env.mail` して使う。
# .env.mail は .gitignore の `.env.*` で無視される。
#
# 使い方:
#   export DATABASE_URL="postgres://postgres:password@localhost:5433/hamburger_evaluation_go_development?sslmode=disable"
#   source backend-go/.env.mail
#   ./scripts/bench/mail-verify.sh resend you@example.com
#
# SMTP_SECURITY は 3 つから選ぶ。
#   tls      … 暗黙の TLS。ポート 465
#   starttls … ポート 587(多くの事業者の既定)
#   none     … 暗号化なし。ローカルの mailpit 用
#
# 注意: 多くの事業者は独自ドメインの SPF / DKIM 設定を求める。共有ドメインのままだと
# 迷惑メール判定されやすい。設定の手数自体が比較の項目になる。

RESEND_SMTP_HOST="smtp.resend.com"
RESEND_SMTP_PORT="587"
RESEND_SMTP_SECURITY="starttls"
RESEND_SMTP_USER="resend"
RESEND_SMTP_PASSWORD=""
RESEND_MAIL_FROM="onboarding@resend.dev"

BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_SECURITY="starttls"
BREVO_SMTP_USER=""
BREVO_SMTP_PASSWORD=""
BREVO_MAIL_FROM=""

SENDGRID_SMTP_HOST="smtp.sendgrid.net"
SENDGRID_SMTP_PORT="587"
SENDGRID_SMTP_SECURITY="starttls"
SENDGRID_SMTP_USER="apikey"
SENDGRID_SMTP_PASSWORD=""
SENDGRID_MAIL_FROM=""

# Gmail はアプリパスワードを使う(2 段階認証が有効なアカウントのみ)。
# 本番では使わない。比較の下限として測る。
GMAIL_SMTP_HOST="smtp.gmail.com"
GMAIL_SMTP_PORT="587"
GMAIL_SMTP_SECURITY="starttls"
GMAIL_SMTP_USER=""
GMAIL_SMTP_PASSWORD=""
GMAIL_MAIL_FROM=""
