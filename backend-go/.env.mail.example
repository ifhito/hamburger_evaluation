# Phase 3(メール送信の比較)用。`cp .env.mail.example .env.mail` して使う。
# .env.mail は .gitignore の `.env.*` で無視される。
#
# 使い方:
#   export DATABASE_URL="postgres://postgres:password@localhost:5433/hamburger_evaluation_go_development?sslmode=disable"
#   source backend-go/.env.mail
#   ./scripts/bench/mail-verify.sh resend    you@example.com
#   ./scripts/bench/mail-verify.sh mailjet   you@example.com
#   ./scripts/bench/mail-verify.sh smtp2go   you@example.com
#   ./scripts/bench/mail-verify.sh mailersend you@example.com
#
# SMTP_SECURITY は 3 つから選ぶ。
#   tls      … 暗黙の TLS。ポート 465
#   starttls … ポート 587(多くの事業者の既定)
#   none     … 暗号化なし。ローカルの mailpit 用
#
# ホスト名とポートは各社のダッシュボードで確認すること(下は公式が案内する既定値)。

# --- Resend: 3,000 通/月・100 通/日。開発者向けで設定が最軽量 ---
# API Keys で作成したキーをパスワードに入れる。ユーザー名は "resend" 固定。
# onboarding@resend.dev は「登録したアドレス宛」にしか送れない。他人に送るには独自ドメインが要る。
RESEND_SMTP_HOST="smtp.resend.com"
RESEND_SMTP_PORT="587"
RESEND_SMTP_SECURITY="starttls"
RESEND_SMTP_USER="resend"
RESEND_SMTP_PASSWORD=""
RESEND_MAIL_FROM="onboarding@resend.dev"

# --- Mailjet: 6,000 通/月・200 通/日。比較した中で無料枠が最大 ---
# ユーザー名に API Key、パスワードに Secret Key を入れる(SMTP 設定の画面に両方ある)。
# 送信元はアドレス 1 つの認証で足りる(独自ドメインは不要)。
MAILJET_SMTP_HOST="in-v3.mailjet.com"
MAILJET_SMTP_PORT="587"
MAILJET_SMTP_SECURITY="starttls"
MAILJET_SMTP_USER=""
MAILJET_SMTP_PASSWORD=""
MAILJET_MAIL_FROM=""

# --- SMTP2GO: 1,000 通/月。SMTP 専業で到達率を売りにする ---
# SMTP Users の画面で作るユーザー名とパスワードを入れる。
SMTP2GO_SMTP_HOST="mail.smtp2go.com"
SMTP2GO_SMTP_PORT="587"
SMTP2GO_SMTP_SECURITY="starttls"
SMTP2GO_SMTP_USER=""
SMTP2GO_SMTP_PASSWORD=""
SMTP2GO_MAIL_FROM=""

# --- MailerSend: 3,000 通/月。MailerLite の配信部門 ---
# Domains → SMTP から発行するユーザー名とパスワードを入れる。
# 試用ドメインが払い出されるが、本番は独自ドメインの認証が要る。
MAILERSEND_SMTP_HOST="smtp.mailersend.net"
MAILERSEND_SMTP_PORT="587"
MAILERSEND_SMTP_SECURITY="starttls"
MAILERSEND_SMTP_USER=""
MAILERSEND_SMTP_PASSWORD=""
MAILERSEND_MAIL_FROM=""
