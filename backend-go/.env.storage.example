# Phase 2(写真ストレージ比較)用。`cp .env.storage.example .env.storage` して使う。
# .env.storage は .gitignore の `.env.*` で無視される。
#
# 使い方:
#   source backend-go/.env.storage
#   ./scripts/bench/storage-verify.sh r2
#   ./scripts/bench/storage-verify.sh supabase
#   ./scripts/bench/storage-verify.sh tigris
#   ./scripts/bench/storage-verify.sh b2
#
# 注意: adapter/storage/s3.go は Region を "auto" でハードコードしている。
# 実リージョンを要求する事業者では署名エラーになる可能性があり、それ自体が検証項目である。
# バケットは「読み取りだけ公開、書き込みはキーを持つ API だけ」に設定すること。

R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_BUCKET="hamburger-photos"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_BASE_URL="https://<公開ドメイン>"

SUPABASE_ENDPOINT="https://<project-ref>.supabase.co/storage/v1/s3"
SUPABASE_BUCKET="photos"
SUPABASE_ACCESS_KEY_ID=""
SUPABASE_SECRET_ACCESS_KEY=""
SUPABASE_PUBLIC_BASE_URL="https://<project-ref>.supabase.co/storage/v1/object/public/photos"

TIGRIS_ENDPOINT="https://fly.storage.tigris.dev"
TIGRIS_BUCKET=""
TIGRIS_ACCESS_KEY_ID=""
TIGRIS_SECRET_ACCESS_KEY=""
TIGRIS_PUBLIC_BASE_URL=""

B2_ENDPOINT="https://s3.<region>.backblazeb2.com"
B2_BUCKET=""
B2_ACCESS_KEY_ID=""
B2_SECRET_ACCESS_KEY=""
B2_PUBLIC_BASE_URL="https://f<NNN>.backblazeb2.com/file/<bucket>"
