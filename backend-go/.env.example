# 検証用の環境変数。`cp .env.example .env` して使う。.env は gitignore 済み。
# 秘密(接続文字列・アクセスキー・SMTP のパスワード)はここにだけ書き、コミットしない。

# 起動に必須
JWT_SECRET=

# --- Phase 1: DB ---
# Neon / Supabase / Render / Xata の接続文字列。多くは sslmode=require が要る。
DATABASE_URL=
DB_MAX_CONNS=5

# --- Phase 2: 写真(S3 互換) ---
# PHOTO_STORAGE=s3 にすると GET /photos/* は登録されず、写真の URL は
# PHOTO_PUBLIC_BASE_URL を指す。
PHOTO_STORAGE=disk
PHOTO_S3_ENDPOINT=
PHOTO_S3_BUCKET=
PHOTO_S3_ACCESS_KEY_ID=
PHOTO_S3_SECRET_ACCESS_KEY=
PHOTO_PUBLIC_BASE_URL=

# --- Phase 3: メール ---
# 既定はローカルの mailpit(http://localhost:8025 で読める)。
# 外部へ送るときは SMTP_SECURITY=starttls(587)または tls(465)。
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@hamburger.example.com

# --- ワーカー ---
STATS_WORKER_INTERVAL=1s
