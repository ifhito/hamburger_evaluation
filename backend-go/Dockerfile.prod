# 互換のための別名。中身は既定の Dockerfile(本番用)と同じ。
#
# 多くの基盤(Back4App Containers など)は Dockerfile 名を選べず、既定の
# `Dockerfile` を見る。そのため本番用を `Dockerfile` に置いた。
# 一方で `Dockerfile.prod` を指定済みの設定が既にある場合に備え、この名前も残す。
#
# 変更するときは Dockerfile 側を直し、ここへ反映すること。
FROM golang:1.27 AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
# CGO なしの静的リンク。-trimpath と -ldflags="-s -w" でバイナリを小さくする。
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/api ./cmd/api

# nonroot 版は UID 65532 で動く。書き込み先を持たない(写真は S3 へ、PHOTO_STORAGE=s3)。
FROM gcr.io/distroless/static:nonroot
COPY --from=build /out/api /api

# PORT はホスト(Render / Cloud Run など)が上書きする。
ENV PORT=8080
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/api"]
