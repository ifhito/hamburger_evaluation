.DS_Store

# Local tooling
.claude/settings.local.json

# Frontend build artifacts and dependencies
frontend/node_modules/
frontend/dist/
# pnpm を docker などで動かしたときに、frontend の中にできる依存の保管場所
frontend/.pnpm-store/

# Environment files
.env
.env.*
frontend/.env
frontend/.env.*
# Penpot(design/)は、値の雛形(.env.example)だけをコミットする。design/.env は鍵を含むのでコミットしない
!design/.env.example
# backend-go も同様に、値の雛形(.env.example)だけをコミットする。backend-go/.env は秘密を含むのでコミットしない
!backend-go/.env.example
!backend-go/.env.bench.example
!backend-go/.env.storage.example

# 旧 API(backend/)の名残として手元に残りうる秘密ファイル。誤って commit しない
backend/.kamal/secrets
backend/config/master.key
backend/.env
backend/.env.*

# Dev-mode review photos written into the bind-mounted repo tree (S10 disk storage)
backend-go/storage/

# Python のキャッシュ(フックのテストで作られる)
__pycache__/
*.pyc
.gocache/
